{
  "version": 1,
  "checks": [
    {
      "id": "parse-version-with-prefix",
      "why": "Tags and registry versions can carry a leading v.",
      "fn": "parseVersion",
      "input": "v8.4.1",
      "expect": { "major": 8, "minor": 4, "patch": 1, "prerelease": "" }
    },
    {
      "id": "version-order",
      "why": "An older dependency must be reported as behind, not ahead.",
      "fn": "compareVersions",
      "input": { "a": "4.3.3", "b": "4.3.5" },
      "expect": -1
    },
    {
      "id": "patch-bump",
      "why": "Tailwind 4.3.3 -> 4.3.5 is a patch bump.",
      "fn": "bumpType",
      "input": { "current": "4.3.3", "latest": "4.3.5" },
      "expect": "patch"
    },
    {
      "id": "minor-bump",
      "why": "Plugin-react 6.1.2 -> 6.3.0 must not be reported as a major.",
      "fn": "bumpType",
      "input": { "current": "6.1.2", "latest": "6.3.0" },
      "expect": "minor"
    },
    {
      "id": "major-bump",
      "why": "jsdom 30 -> 31 must be flagged as a major so it is reviewed.",
      "fn": "bumpType",
      "input": { "current": "30.1.3", "latest": "31.0.0" },
      "expect": "major"
    },
    {
      "id": "prerelease-is-not-stable",
      "why": "nodejs.org lists v27.0.0-alpha first; it must never be reported as the newest usable Node.",
      "fn": "isStable",
      "input": "v27.0.0-alpha.0.0.0",
      "expect": false
    },
    {
      "id": "release-is-stable",
      "why": "A release without a suffix is usable.",
      "fn": "isStable",
      "input": "v26.13.0",
      "expect": true
    },
    {
      "id": "codeql-bundle-tag-is-not-a-release-tag",
      "why": "github/codeql-action/releases/latest redirects to codeql-bundle-v2.27.4, which is not the action version.",
      "fn": "isReleaseTag",
      "input": "codeql-bundle-v2.27.4",
      "expect": false
    },
    {
      "id": "plain-semver-tag-is-a-release-tag",
      "why": "The action versions look like v4.39.3.",
      "fn": "isReleaseTag",
      "input": "v4.39.3",
      "expect": true
    },
    {
      "id": "prerelease-tag-is-not-a-release-tag",
      "why": "Never auto-pin an action to a release candidate.",
      "fn": "isReleaseTag",
      "input": "v1.2.3-rc.1",
      "expect": false
    },
    {
      "id": "keep-caret-range",
      "why": "package.json uses ^ ranges; the range operator must survive a bump.",
      "fn": "nextSpec",
      "input": { "spec": "^18.1.2", "latest": "18.1.3" },
      "expect": "^18.1.3"
    },
    {
      "id": "keep-tilde-range",
      "why": "Only the version changes, whatever the range operator is.",
      "fn": "nextSpec",
      "input": { "spec": "~1.2.3", "latest": "1.2.9" },
      "expect": "~1.2.9"
    },
    {
      "id": "keep-exact-version",
      "why": "An exact version must stay exact.",
      "fn": "nextSpec",
      "input": { "spec": "1.2.3", "latest": "1.2.4" },
      "expect": "1.2.4"
    },
    {
      "id": "parse-pinned-workflow-line",
      "why": "The workflow pins actions to a full commit and keeps the tag in a comment.",
      "fn": "parseUseLine",
      "input": "        uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1",
      "expect": {
        "prefix": "        uses: ",
        "action": "pnpm/action-setup",
        "repo": "pnpm/action-setup",
        "ref": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "comment": "v6.1.1",
        "suffix": ""
      }
    },
    {
      "id": "parse-step-list-workflow-line",
      "why": "Actions can be written as a list item with a tag instead of a SHA.",
      "fn": "parseUseLine",
      "input": "      - uses: actions/checkout@v7.0.1",
      "expect": {
        "prefix": "      - uses: ",
        "action": "actions/checkout",
        "repo": "actions/checkout",
        "ref": "v7.0.1",
        "comment": "",
        "suffix": ""
      }
    },
    {
      "id": "parse-action-with-subpath",
      "why": "github/codeql-action/upload-sarif must be parsed, but releases are queried on github/codeql-action.",
      "fn": "parseUseLine",
      "input": "        uses: github/codeql-action/upload-sarif@9b3254085494b55a0f7c4c2b3d2d52cc712ce370 # v4.39.1",
      "expect": {
        "prefix": "        uses: ",
        "action": "github/codeql-action/upload-sarif",
        "repo": "github/codeql-action",
        "ref": "9b3254085494b55a0f7c4c2b3d2d52cc712ce370",
        "comment": "v4.39.1",
        "suffix": ""
      }
    },
    {
      "id": "ignore-docker-uses",
      "why": "uses: docker://... is not a GitHub action and must be left alone.",
      "fn": "parseUseLine",
      "input": "      - uses: docker://alpine:3",
      "expect": null
    },
    {
      "id": "ignore-local-action",
      "why": "uses: ./.github/actions/... is a local action, not owner/repo.",
      "fn": "parseUseLine",
      "input": "      - uses: ./.github/actions/build",
      "expect": null
    },
    {
      "id": "render-pinned-workflow-line",
      "why": "Writing an update must keep the indentation and add the tag comment.",
      "fn": "renderActionUse",
      "input": {
        "prefix": "        uses: ",
        "action": "pnpm/action-setup",
        "sha": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "tag": "v6.1.1",
        "suffix": ""
      },
      "expect": "        uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1"
    },
    {
      "id": "render-action-with-subpath",
      "why": "The subpath must survive a rewrite, otherwise upload-sarif becomes the wrong action.",
      "fn": "renderActionUse",
      "input": {
        "prefix": "        uses: ",
        "action": "github/codeql-action/upload-sarif",
        "sha": "f3bbb05694c2f74569081c28664c0866d64dec21",
        "tag": "v4.39.3",
        "suffix": ""
      },
      "expect": "        uses: github/codeql-action/upload-sarif@f3bbb05694c2f74569081c28664c0866d64dec21 # v4.39.3"
    },
    {
      "id": "tag-from-release-redirect",
      "why": "The script reads the latest tag from the redirected releases/latest URL.",
      "fn": "tagFromReleaseUrl",
      "input": "https://github.com/actions/checkout/releases/tag/v7.0.1",
      "expect": "v7.0.1"
    },
    {
      "id": "no-tag-from-latest-url",
      "why": "A redirect to /releases/latest (no release) is not a tag.",
      "fn": "tagFromReleaseUrl",
      "input": "https://github.com/some/repo/releases/latest",
      "expect": null
    },
    {
      "id": "annotated-tag-peels-to-commit",
      "why": "uses: needs a commit SHA, not the annotated tag object SHA (pnpm/action-setup v6.1.1).",
      "fn": "pickCommit",
      "input": {
        "output": "9bbca1e9dc2902adb87e8780fe5c98796985a62d\trefs/tags/v6.1.1\n73e46992e05b19abd31f2f3c20e0e7370d762115\trefs/tags/v6.1.1^{}\n",
        "tag": "v6.1.1"
      },
      "expect": "73e46992e05b19abd31f2f3c20e0e7370d762115"
    },
    {
      "id": "lightweight-tag-uses-commit",
      "why": "A lightweight tag has no peeled entry; its own SHA is the commit.",
      "fn": "pickCommit",
      "input": {
        "output": "3d3c42e5aac5ba805825da76410c181273ba90b1\trefs/tags/v7.0.1\n",
        "tag": "v7.0.1"
      },
      "expect": "3d3c42e5aac5ba805825da76410c181273ba90b1"
    },
    {
      "id": "current-pin-is-current",
      "why": "A matching commit and tag comment means there is nothing to write.",
      "fn": "isCurrentPin",
      "input": {
        "ref": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "comment": "v6.1.1",
        "sha": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "tag": "v6.1.1"
      },
      "expect": true
    },
    {
      "id": "stale-comment-is-updated",
      "why": "The pin can be right while the comment still names the old tag.",
      "fn": "isCurrentPin",
      "input": {
        "ref": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "comment": "v6.1.0",
        "sha": "73e46992e05b19abd31f2f3c20e0e7370d762115",
        "tag": "v6.1.1"
      },
      "expect": false
    },
    {
      "id": "tag-ref-is-not-pinned",
      "why": "An action written with a tag must be pinned to a SHA, even when the tag is latest.",
      "fn": "isCurrentPin",
      "input": {
        "ref": "v7.0.1",
        "comment": "",
        "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1",
        "tag": "v7.0.1"
      },
      "expect": false
    },
    {
      "id": "find-pnpm-version-in-action-step",
      "why": "pnpm is pinned under `with: version:` in pnpm/action-setup; the scanner must cross `with:` and stop at the next step.",
      "fn": "findPnpmVersionPin",
      "input": "      - name: Install pnpm\n        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0\n        with:\n          # Keep in sync with engines.pnpm and the Dockerfile\n          version: 12.16.1\n\n      - name: Get pnpm store directory\n        run: echo hi\n",
      "expect": { "index": 4, "version": "12.16.1" }
    },
    {
      "id": "ignore-version-outside-pnpm-step",
      "why": "A workflow without pnpm/action-setup must not have an unrelated version: line rewritten.",
      "fn": "findPnpmVersionPin",
      "input": "      - name: Build\n        with:\n          version: 9.9.9\n",
      "expect": null
    },
    {
      "id": "find-pnpm-docker-pin",
      "why": "The Dockerfile installs the same pnpm version globally and must move with the workflow pin.",
      "fn": "findPnpmDockerPin",
      "input": "FROM node:26-alpine AS builder\n\n# Keep in sync with engines.pnpm in package.json and the CI workflow\nRUN npm install -g pnpm@12.16.1\n",
      "expect": { "index": 3, "version": "12.16.1" }
    },
    {
      "id": "raise-engines-floor-keep-upper-bound",
      "why": "engines.pnpm is a range; bumping the pin must keep the <13 ceiling.",
      "fn": "nextEngineRange",
      "input": { "range": ">=12.16.1 <13", "version": "12.18.0" },
      "expect": ">=12.18.0 <13"
    },
    {
      "id": "parse-workspace-overrides",
      "why": "pnpm-workspace.yaml holds a brace-expansion override that is also a dependency version.",
      "fn": "parseOverrides",
      "input": "allowBuilds:\n  browser-tabs-lock: true\n\noverrides:\n  brace-expansion: '5.0.12'\n",
      "expect": [
        {
          "name": "brace-expansion",
          "spec": "5.0.12",
          "index": 4,
          "indent": 2,
          "quote": "'"
        }
      ]
    },
    {
      "id": "render-workspace-override",
      "why": "Rewriting an override must keep its indentation and quotes.",
      "fn": "renderOverrideLine",
      "input": {
        "indent": 2,
        "name": "brace-expansion",
        "quote": "'",
        "latest": "5.0.13"
      },
      "expect": "  brace-expansion: '5.0.13'"
    },
    {
      "id": "write-plan-without-pnpm-update",
      "why": "A run that only updates packages must not crash while planning pnpm pins.",
      "fn": "planPnpmPins",
      "input": null,
      "expect": []
    },
    {
      "id": "write-plan-with-pnpm-update",
      "why": "A real pnpm update still returns the pins that must be rewritten.",
      "fn": "planPnpmPins",
      "input": {
        "pins": [
          { "kind": "workflow", "file": ".github/workflows/deploy.yml", "index": 47, "version": "12.16.1" }
        ]
      },
      "expect": [
        {
          "kind": "workflow",
          "file": ".github/workflows/deploy.yml",
          "index": 47,
          "version": "12.16.1"
        }
      ]
    }
  ]
}
